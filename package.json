{
  "name": "digital-travel-book",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @tb/api",
    "dev:web": "npm run dev -w @tb/web",
    "build": "npm run build -w @tb/web",
    "start": "npm run start -w @tb/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fixtures": "node fixtures/generate.ts",
    "test:integration": "RUN_CLOUDINARY_INTEGRATION=1 node --env-file=.env.production.local node_modules/vitest/vitest.mjs run apps/api/src/lib/cloudinaryStorage.integration.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jpeg-js": "^0.4.4",
    "piexifjs": "^1.0.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
