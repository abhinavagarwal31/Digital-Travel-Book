# Copy this file to `.env` (git-ignored) and fill in real values.
# Never commit `.env`. Everything below is a placeholder.

NODE_ENV=development
PORT=3000

# Local: a mongod on your machine. Production: the Atlas mongodb+srv:// string.
MONGODB_URI=mongodb://127.0.0.1:27017/travel-book

# Signs login sessions. 32+ random characters. Generate one with:
#   openssl rand -base64 48
# Use a different value in production, and never reuse it elsewhere.
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# Photo storage (cloudinary.com → Dashboard). Optional in development: without
# them the app runs but uploads are disabled. Required in production.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your-api-secret
